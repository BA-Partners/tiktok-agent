# Local SQLite database
SQLITE_DB_PATH=data/app.sqlite

# Optional API key for every API route.
# Strongly recommended before exposing this service through a tunnel or public URL.
# Example: LOCAL_API_KEY=$(openssl rand -hex 24)
LOCAL_API_KEY=

# Ollama must be reachable from the same machine that runs this API.
# If the API and Ollama both run on your Mac, keep localhost.
# If Ollama runs on another machine, use that machine's reachable IP or tunnel URL.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=120000

# Public model name exposed by /v1/models and accepted by OpenAI-compatible clients.
PUBLIC_MODEL_NAME=claw-chat-v1

# Local file-based RAG knowledge base
RAG_ENABLED=true
RAG_KB_DIR=knowledge
RAG_TOP_K=4
RAG_CHUNK_SIZE=1200

# API server port
PORT=3000
